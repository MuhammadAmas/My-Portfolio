{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://*.googletagmanager.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self' https://formsubmit.co https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com https://*.g.doubleclick.net https://www.google.com https://firebase.googleapis.com https://firebaseinstallations.googleapis.com; frame-src https://www.googletagmanager.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/projects/chatbot-authentication", "destination": "/projects/chatbot-authentication/index.html" },
    { "source": "/projects/insightedu", "destination": "/projects/insightedu/index.html" },
    { "source": "/projects/langx", "destination": "/projects/langx/index.html" },
    { "source": "/projects/cloudnosys", "destination": "/projects/cloudnosys/index.html" },
    { "source": "/projects/quicknotes", "destination": "/projects/quicknotes/index.html" },
    { "source": "/projects/mailspend", "destination": "/projects/mailspend/index.html" },
    { "source": "/projects", "destination": "/projects/index.html" },
    { "source": "/publications/scaling-real-time-broadcasting-in-node-js-with-redis-pub-sub", "destination": "/publications/scaling-real-time-broadcasting-in-node-js-with-redis-pub-sub/index.html" },
    { "source": "/publications/how-i-passed-the-google-cloud-digital-leader-exam", "destination": "/publications/how-i-passed-the-google-cloud-digital-leader-exam/index.html" },
    { "source": "/publications/what-is-cloud-computing", "destination": "/publications/what-is-cloud-computing/index.html" },
    { "source": "/publications/the-day-crowdstrike-broke-the-internet-what-went-wrong", "destination": "/publications/the-day-crowdstrike-broke-the-internet-what-went-wrong/index.html" },
    { "source": "/publications/from-zero-to-one-insights-on-startups-by-peter-thiel", "destination": "/publications/from-zero-to-one-insights-on-startups-by-peter-thiel/index.html" },
    { "source": "/publications/javascript-solution-overcoming-popup-blocking-issues-in-browser", "destination": "/publications/javascript-solution-overcoming-popup-blocking-issues-in-browser/index.html" },
    { "source": "/publications/how-to-kill-a-localhost-port", "destination": "/publications/how-to-kill-a-localhost-port/index.html" },
    { "source": "/publications/the-new-world-order-why-adaptability-is-the-new-normal", "destination": "/publications/the-new-world-order-why-adaptability-is-the-new-normal/index.html" },
    { "source": "/publications/why-are-homo-sapiens-addicted-to-screens", "destination": "/publications/why-are-homo-sapiens-addicted-to-screens/index.html" },
    { "source": "/publications/how-to-publish-your-code-on-github-from-vs-code", "destination": "/publications/how-to-publish-your-code-on-github-from-vs-code/index.html" },
    { "source": "/publications", "destination": "/publications/index.html" },
    { "source": "/contact", "destination": "/contact/index.html" },
    { "source": "/improve", "destination": "/improve/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
